{{!-- views/movie-details.hbs --}}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            {{!-- Immagine del film con gestione del placeholder --}}
            <img src="{{#if movie.posterUrl}}{{movie.posterUrl}}{{else}}/images/landscape-placeholder.jpg{{/if}}"
                 alt="Locandina di {{movie.name}}"
                 class="img-fluid movie-detail-image">
        </div>
        <div class="col-md-8">
            <h1>{{movie.name}}</h1>
            <p><strong>Anno:</strong> {{movie.date}}</p>
            <p><strong>Tagline:</strong> {{movie.tagline}}</p>
            <p><strong>Descrizione:</strong> {{movie.description}}</p>
            <p><strong>Durata:</strong> {{movie.minute}} minuti</p>
            <p><strong>Valutazione:</strong> {{movie.rating}}</p>

            <a href="/" class="btn btn-secondary mt-3">Torna alla Ricerca</a>
        </div>
    </div>

    {{!-- Sezione Recensioni (rimossa, per ora) --}}
    {{!--
    <div class="row mt-4">
        <div class="col">
            <h2>Recensioni</h2>
            ... (codice delle recensioni) ...
        </div>
    </div>
    --}}
</div>